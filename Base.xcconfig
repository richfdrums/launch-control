// The app target's settings. Signing is per person, so it lives in Local.xcconfig (git-ignored),
// copied from Local.xcconfig.example. Set the team there rather than in Xcode's Signing pane,
// which would write it into project.pbxproj.
BUNDLE_ID_PREFIX = local.launchmode
LAUNCHMODE_TEAM =
#include? "Local.xcconfig"

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).app
DEVELOPMENT_TEAM = $(LAUNCHMODE_TEAM)
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
SWIFT_EMIT_LOC_STRINGS = NO

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Launch Mode
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
// Portrait only: the phone is mounted upright in the car.
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UIStatusBarHidden = YES
INFOPLIST_KEY_UIUserInterfaceStyle = Dark

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
