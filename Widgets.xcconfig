// The widget extension's settings: the Live Activity (LaunchControlWidgets), embedded in the app.
// Signing comes from Local.xcconfig, as for the app.
BUNDLE_ID_PREFIX = local.launchcontrol
LAUNCHCONTROL_TEAM =
#include? "Local.xcconfig"

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).app.widgets
DEVELOPMENT_TEAM = $(LAUNCHCONTROL_TEAM)
CODE_SIGN_STYLE = Automatic
// The same as the app's (Base.xcconfig): an extension's version has to match its app's.
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 5.0
SWIFT_EMIT_LOC_STRINGS = NO
APPLICATION_EXTENSION_API_ONLY = YES
SKIP_INSTALL = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_FILE = Widgets-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = Launch Control
